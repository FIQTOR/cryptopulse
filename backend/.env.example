# CryptoPulse backend environment
PORT=8787
# Optional: CoinGecko demo key (free) -> https://www.coingecko.com/en/api
# Leave empty to use the public rate-limited endpoint (no key needed).
COINGECKO_API_KEY=
# Cache TTLs (seconds)
CACHE_TTL_PRICES=30
CACHE_TTL_COIN=60
CACHE_TTL_CHART=300
CACHE_TTL_NEWS=600
